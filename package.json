{
  "name": "jewelry-repair-crm",
  "version": "0.1.0",
  "private": true,
  "description": "CRM для управления и контроля операций ремонта ювелирных изделий",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:shared && npm run build:api && npm run build:web",
    "build:shared": "npm run build --workspace @app/shared",
    "build:api": "npm run build --workspace @app/api",
    "build:web": "npm run build --workspace @app/web",
    "dev": "npm run dev --workspace @app/api & npm run dev --workspace @app/web",
    "dev:api": "npm run dev --workspace @app/api",
    "dev:web": "npm run dev --workspace @app/web",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "typecheck": "tsc --noEmit -p packages/shared/tsconfig.json && tsc --noEmit -p packages/db/tsconfig.json && tsc --noEmit -p apps/api/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace @app/api",
    "db:generate": "npm run generate --workspace @app/db",
    "db:migrate": "npm run migrate:dev --workspace @app/db",
    "db:deploy": "npm run migrate:deploy --workspace @app/db",
    "db:seed": "npm run seed --workspace @app/db",
    "db:studio": "npm run studio --workspace @app/db",
    "db:reset": "npm run reset --workspace @app/db",
    "infra:up": "docker compose -f infra/docker/docker-compose.dev.yml up -d",
    "infra:down": "docker compose -f infra/docker/docker-compose.dev.yml down",
    "infra:logs": "docker compose -f infra/docker/docker-compose.dev.yml logs -f",
    "local:db": "node scripts/local-db.mjs start",
    "local:db:stop": "node scripts/local-db.mjs stop",
    "local:db:reset": "node scripts/local-db.mjs reset",
    "local:db:status": "node scripts/local-db.mjs status",
    "local:setup": "node scripts/local-setup.mjs",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "pg": "^8.13.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^2.1.8"
  },
  "optionalDependencies": {
    "@embedded-postgres/darwin-x64": "16.14.0-beta.17",
    "@embedded-postgres/linux-x64": "16.14.0-beta.17"
  }
}
