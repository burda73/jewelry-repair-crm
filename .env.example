# ============================================================================
# Пример переменных окружения. Скопируйте в .env и заполните.
# ВАЖНО: .env в .gitignore. Секреты в репозиторий не попадают.
# ============================================================================

# --- Общее -------------------------------------------------------------------
NODE_ENV=development
APP_NAME="CRM Ремонт ювелирных изделий"
# Публичный адрес веб-приложения (его выдаёт внешний nginx-proxy).
# Продакшн: https://repair.remixgold.ru
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
TZ=Europe/Moscow
# Уровень логов: error | warn | info | debug
LOG_LEVEL=debug

# --- Прокси (ответ A1) -------------------------------------------------------
# Сколько прокси доверять при определении IP клиента.
# В продакшне API стоит за внешним nginx-proxy → 1.
# КРИТИЧНО: без этого ограничение частоты запросов будет считать всех клиентов
# одним адресом, и несколько неудачных входов заблокируют вход всей сети.
# Не используйте true — тогда IP подделывается заголовком X-Forwarded-For.
TRUST_PROXY=1
# Порты, которые проект публикует для внешнего прокси
WEB_PORT=3000
API_PORT=4000

# --- База данных (ВНЕШНЯЯ) ---------------------------------------------------
# ВАЖНО (ответ A1): PostgreSQL 16 уже есть в инфраструктуре предприятия.
# Проект его НЕ устанавливает и не поднимает в Docker — используем существующий.
# Подготовка БД, роль, расширения и права: infra/db/README.md
# Проверка готовности перед деплоем: ./infra/db/preflight.sh
#
# НЕ localhost: укажите сервер БД предприятия. Роль — отдельная, НЕ суперпользователь.
# sslmode: prefer (по умолчанию) | require (если сервер требует TLS) | disable
DATABASE_URL="postgresql://repair_app:CHANGE_ME@pg-server.remixgold.ru:5432/repair?schema=public&sslmode=prefer"
# Строка подключения к реплике для отчётных запросов (опционально)
DATABASE_REPLICA_URL=""
# Пул соединений НА ПРОЦЕСС. Сервер общий: не занимайте все соединения!
# Всего будет POOL_SIZE × (2 реплики API + 1 воркер). Расчёт — infra/db/README.md §1.4
DATABASE_POOL_SIZE=10

# --- Redis (очереди, кэш) ----------------------------------------------------
REDIS_URL="redis://localhost:6379"

# --- Аутентификация ----------------------------------------------------------
# ОБЯЗАТЕЛЬНО заменить в продакшне: openssl rand -base64 48
JWT_ACCESS_SECRET="CHANGE_ME_access_secret_at_least_32_chars_long"
JWT_REFRESH_SECRET="CHANGE_ME_refresh_secret_at_least_32_chars_long"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
# Число неудачных попыток входа до блокировки
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=15
# Секрет для double-submit CSRF
CSRF_SECRET="CHANGE_ME_csrf_secret"

# --- Хранилище файлов ---------------------------------------------------------
# LOCAL — файлы на диске сервера, раздача через API (значение по умолчанию).
# S3    — объектное хранилище; тогда обязательны S3_ENDPOINT/S3_ACCESS_KEY/S3_SECRET_KEY.
# Для текущей инфраструктуры выбран LOCAL: S3/MinIO в ней нет.
STORAGE_DRIVER=LOCAL
# Каталог ВНЕ каталога приложения: пересборка не должна стирать фото клиентов.
STORAGE_LOCAL_DIR="/opt/repair/data/files"
# Максимальный размер загружаемого файла, байт (10 МБ)
UPLOAD_MAX_BYTES=10485760

# Настройки ниже нужны только при STORAGE_DRIVER=S3
S3_ENDPOINT="http://localhost:9000"
S3_REGION="ru-central1"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_FORCE_PATH_STYLE=true
S3_BUCKET_PHOTOS="repair-photos"
S3_BUCKET_CALLS="repair-calls"
S3_BUCKET_DOCS="repair-docs"
# Время жизни подписанной ссылки, секунды
S3_SIGNED_URL_TTL=900

# --- Почта (уведомления сотрудникам) -----------------------------------------
# Канал выключен, пока SMTP_HOST пуст: уведомления остаются в системе со
# статусом FAILED и причиной «SMTP не настроен». Значений по умолчанию у хоста и
# порта НЕТ намеренно — раньше здесь стоял адрес локального отладочного сервера
# (localhost:1025), из-за чего «не настроено» было неотличимо от «настроено», и
# продакшн молча пытался отправить письма в никуда.
#
# Для внутреннего почтового сервера заказчика укажите его адрес, например:
#   SMTP_HOST="mail.remixgold.local"
#   SMTP_PORT=25
SMTP_HOST=""
SMTP_PORT=
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@remixgold.ru"
# Шифрование задаётся ЯВНО: 465 требует true, 587 начинает с открытого
# соединения и повышает его через STARTTLS. Выводить это из номера порта нельзя.
SMTP_SECURE=false

# --- Интеграция с 1С --------------------------------------------------------
# Включить обмен. Если false — платежи принимаются, синхронизация не выполняется.
INTEGRATION_1C_ENABLED=false
# Транспорт: HTTP_SERVICE | ODATA | FILE_EXCHANGE
INTEGRATION_1C_TRANSPORT=HTTP_SERVICE
INTEGRATION_1C_BASE_URL="http://1c-server/repair/hs/exchange"
INTEGRATION_1C_USER=""
INTEGRATION_1C_PASSWORD=""
INTEGRATION_1C_TIMEOUT_MS=15000
# Число попыток перед переводом в DEAD
INTEGRATION_1C_MAX_ATTEMPTS=10
# Интервал опроса очереди, мс
INTEGRATION_OUTBOX_INTERVAL_MS=30000

# --- Интеграция с IP-АТС ----------------------------------------------------
INTEGRATION_PBX_ENABLED=false
# Провайдер: ASTERISK_CDR | ASTERISK_AMI | MANGO | BITRIX24 | WEBHOOK
INTEGRATION_PBX_PROVIDER=ASTERISK_CDR
INTEGRATION_PBX_BASE_URL=""
INTEGRATION_PBX_API_KEY=""
# Путь к CDR-файлу для провайдера ASTERISK_CDR
INTEGRATION_PBX_CDR_PATH="/var/spool/asterisk/cdr-csv/Master.csv"
# Интервал импорта журнала звонков, мс
INTEGRATION_PBX_POLL_INTERVAL_MS=300000
# Срок хранения записей разговоров, дней (ТЗ п. 2.4 — 1 год)
CALL_RECORDING_RETENTION_DAYS=365

# --- Уведомления клиентам (опционально, этап 5) ------------------------------
NOTIFICATIONS_SMS_ENABLED=false
SMS_PROVIDER=""
SMS_API_KEY=""
SMS_SENDER=""

# --- Бизнес-параметры --------------------------------------------------------
# Срок, после которого готовый заказ считается невостребованным (ТЗ п. 2.8)
UNCLAIMED_AFTER_DAYS=30
# Срок рассмотрения рекламации в рабочих днях (ТЗ п. 2.9)
CLAIM_REVIEW_WORKDAYS=10
# Гарантия по умолчанию, месяцев (ТЗ п. 2.9: 6 обычный, 3 закрепка)
WARRANTY_MONTHS_DEFAULT=6
WARRANTY_MONTHS_SETTING=3
# Интервал проверки просрочек, мс
ESCALATION_INTERVAL_MS=900000

# --- Отчёты ------------------------------------------------------------------
REPORT_CACHE_TTL_SECONDS=900
# Порог, после которого отчёт считается асинхронным, мс
REPORT_ASYNC_THRESHOLD_MS=5000

# --- Мониторинг (опционально) ------------------------------------------------
METRICS_ENABLED=true
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=""